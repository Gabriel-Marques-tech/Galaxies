# Copie para .env e preencha. O .env nunca vai para o git.
YOUTUBE_API_KEY=
# VLM do gancho. Preferido: Google AI Studio (plano gratuito). OpenRouter é alternativa paga.
GEMINI_API_KEY=
GEMINI_MODELO=gemini-3.1-flash-lite
OPENROUTER_API_KEY=
# Modelo de visão usado para descrever o gancho (via OpenRouter).
OPENROUTER_MODELO=google/gemini-2.5-flash-lite
# Jev via Cloudflare Workers AI.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Pasta onde ficam os projetos (DuckDB, frames).
GALAXIES_DADOS=data
# laya (local, grátis), um modelo @cf/* grátis do Workers AI ou typesafe/jev (pago)
ATRIBUTOS_MODELO=@cf/meta/llama-3.1-8b-instruct-fast
