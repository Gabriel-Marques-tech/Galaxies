# Copie para .env e preencha. O .env nunca vai para o git.
YOUTUBE_API_KEY=
OPENROUTER_API_KEY=
# Modelo de visão usado para descrever o gancho (via OpenRouter).
OPENROUTER_MODELO=google/gemini-2.5-flash-lite
# Jev via Cloudflare Workers AI.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Pasta onde ficam os projetos (DuckDB, frames).
GALAXIES_DADOS=data
